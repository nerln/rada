<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Rada</string>
    <key>CFBundleDisplayName</key>
    <string>Rada</string>
    <key>CFBundleExecutable</key>
    <string>Rada</string>
    <key>CFBundleIconFile</key>
    <string>Rada</string>
    <key>CFBundleIdentifier</key>
    <string>dev.nerelli.rada</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Eugenio Nerelli</string>
    <!-- The window shows a queue and quitting it decides nothing. Terminating while a
         job is queued or running is not a state worth protecting against: the queue is a
         file, and the processes waiting on it are other people's. -->
    <!-- Opened by the command line with `open -g rada://stuck/<ticket>` when a job has
         been waiting for memory nothing is going to free. The ticket is the only thing
         the url carries, it is checked against the queue before anything is shown, and
         it can never be a command: any page in any browser can open a url scheme. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>dev.nerelli.rada</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>rada</string>
            </array>
        </dict>
    </array>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <key>NSSupportsSuddenTermination</key>
    <true/>
</dict>
</plist>
